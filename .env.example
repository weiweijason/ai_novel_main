# ========================================
# AI Anime Studio - 環境變數範本
# ========================================
# 使用方法:
# 1. 複製此檔案為 .env
#    cp .env.example .env
# 2. 根據實際環境修改值
# ========================================

# --- PostgreSQL 資料庫 ---
POSTGRES_PASSWORD=anime

# --- MinIO 物件儲存 ---
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
S3_BUCKET=assets

# --- Orchestrator 設定 ---
ORCHESTRATOR_POLL_SECONDS=3

# ========================================
# GPU Worker 設定
# ========================================

# --- Image Worker (ComfyUI) ---
# 部署至: RTX 5090 32GB VRAM
IMAGE_WORKER_ID=image-01
COMFYUI_API_URL=http://comfyui:8188
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
CFG_SCALE=7.5
NUM_INFERENCE_STEPS=30
SAMPLER=euler_ancestral

# --- Video Worker (Wan) ---
# 部署至: RTX 5080 16GB VRAM
VIDEO_WORKER_ID=video-01
WAN_MODEL_PATH=/models/wan
MOTION_MODEL_PATH=/models/motion
MAX_VIDEO_LENGTH=300
VIDEO_FPS=24
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_INFERENCE_STEPS=50

# --- Audio Worker (F5-TTS / Whisper) ---
# 部署至: RTX 5060 Ti 8GB VRAM
AUDIO_WORKER_ID=audio-01
F5_TTS_MODEL_PATH=/models/f5-tts/base
WHISPER_MODEL_SIZE=medium
SAMPLE_RATE=44100
AUDIO_FORMAT=wav
VOICE_CLONE_ENABLED=true

# --- Editor Worker (FFmpeg) ---
# 部署至: CPU (可選 GPU 加速)
EDITOR_WORKER_ID=editor-01
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
OUTPUT_FORMAT=mp4
OUTPUT_WIDTH=1920
OUTPUT_HEIGHT=1080
OUTPUT_FPS=24
OUTPUT_VIDEO_BITRATE=10M
OUTPUT_AUDIO_BITRATE=192k

# ========================================
# 獨立部署模式 (可選)
# ========================================
# 如果 Worker 部署到不同的機器，修改以下設定:

# Image Worker (獨立部署時)
# IMAGE_WORKER_API_BASE_URL=http://<api-server-ip>:8000
# IMAGE_WORKER_S3_ENDPOINT=http://<minio-server-ip>:9000

# Video Worker (獨立部署時)
# VIDEO_WORKER_API_BASE_URL=http://<api-server-ip>:8000
# VIDEO_WORKER_S3_ENDPOINT=http://<minio-server-ip>:9000

# Audio Worker (獨立部署時)
# AUDIO_WORKER_API_BASE_URL=http://<api-server-ip>:8000
# AUDIO_WORKER_S3_ENDPOINT=http://<minio-server-ip>:9000

# Editor Worker (獨立部署時)
# EDITOR_WORKER_API_BASE_URL=http://<api-server-ip>:8000
# EDITOR_WORKER_S3_ENDPOINT=http://<minio-server-ip>:9000
