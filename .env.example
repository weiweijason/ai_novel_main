# ========================================
# AI Anime Studio - 環境變數範本
# ========================================
# 使用方法:
# 1. 複製此檔案為 .env
#    cp .env.example .env
# 2. 根據實際環境修改值
# ========================================

# --- PostgreSQL 資料庫 ---
POSTGRES_PASSWORD=anime

# --- MinIO 物件儲存 ---
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
S3_BUCKET=assets

# --- Orchestrator 設定 ---
ORCHESTRATOR_POLL_SECONDS=3

# ========================================
# GPU Worker 設定
# ========================================

# --- Image Worker (ComfyUI) ---
# 部署至: RTX 5090 32GB VRAM
#
# 推薦模型 (選一即可，不需要全部下載):
#
# 方案 A: 動漫風格 (推薦)
#   模型: KBlueLeaf/kohaku-v4.1
#   下載: https://huggingface.co/KBlueLeaf/kohaku-v4.1
#   大小: ~6.9GB (FP16)
#   優點: 專門針對動漫風格微調，品質最佳
#
# 方案 B: 通用基礎模型
#   模型: stabilityai/stable-diffusion-xl-base-1.0
#   下載: https://huggingface.co/stabilityai/stable-diffusion-xl-base-1.0
#   大小: ~6.9GB (FP16)
#   優點: 官方模型，相容性最好，可生成各種風格
#
# 放置路徑: /models/sd/<model_name>.safetensors
#
IMAGE_WORKER_ID=image-01
COMFYUI_API_URL=http://comfyui:8188
SD_MODEL_PATH=/models/sd/kohaku-v4.1.safetensors
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
CFG_SCALE=7.5
NUM_INFERENCE_STEPS=30
SAMPLER=euler_ancestral

# --- Video Worker (Wan) ---
# 部署至: RTX 5080 16GB VRAM
#
# 推薦模型 (選一即可):
#
# 方案 A: Wan 2.1 NF4 量化版 (推薦，適合 16GB VRAM)
#   模型: Wan-AI/Wan2.1-I2V-14B-720P-NF4
#   下載: https://huggingface.co/Wan-AI/Wan2.1-I2V-14B-720P-NF4
#   大小: ~8GB (NF4 量化)
#   優點: VRAM 需求低，品質損失小，適合 RTX 5080
#
# 方案 B: Wan 2.1 FP16 完整版 (需要 40GB+ VRAM)
#   模型: Wan-AI/Wan2.1-I2V-14B-720P
#   下載: https://huggingface.co/Wan-AI/Wan2.1-I2V-14B-720P
#   大小: ~28GB (FP16)
#   優點: 最佳品質，但需要 A100/H100 等級 GPU
#
# 方案 C: Wan 2.1 1.3B 輕量版
#   模型: Wan-AI/Wan2.1-T2V-1.3B
#   下載: https://huggingface.co/Wan-AI/Wan2.1-T2V-1.3B
#   大小: ~3GB
#   優點: 速度快，VRAM 需求低，品質較低
#
# Wan 2.1 NF4 模型結構 (下載後):
#   /models/wan/
#   └── Wan2.1-I2V-14B-720P-NF4.safetensors  (~8GB 單一檔案)
#
VIDEO_WORKER_ID=video-01
WAN_MODEL_PATH=/models/wan/Wan2.1-I2V-14B-720P-NF4.safetensors
MOTION_MODEL_PATH=/models/motion
MAX_VIDEO_LENGTH=300
VIDEO_FPS=24
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_INFERENCE_STEPS=50

# --- Audio Worker (F5-TTS / Whisper / MusicGen) ---
# 部署至: RTX 5060 Ti 8GB VRAM
#
# 推薦模型:
#
# 1. F5-TTS (語音合成) - 必須
#    模型: SWivid/F5-TTS
#    下載: https://huggingface.co/SWivid/F5-TTS
#    大小: ~2GB
#    優點: 高品質語音，支援情緒/語速控制
#
# 2. Whisper Medium (語音辨識) - 建議
#    模型: openai/whisper-medium
#    下載: https://huggingface.co/openai/whisper-medium
#    大小: ~1.5GB
#    優點: 多語言辨識，VRAM 需求較低
#
#    替代: openai/whisper-large-v3 (~3GB, 準確率更高但 VRAM 需求大)
#
# 3. MusicGen Large (背景音樂生成) - 可選
#    模型: facebook/musicgen-large
#    下載: https://huggingface.co/facebook/musicgen-large
#    大小: ~9GB
#    優點: Meta 官方模型，音樂品質佳
#
#    替代: stabilityai/stable-audio-open-1.0 (~1.5GB, 較輕量)
#
# 模型結構 (下載後):
#   /models/
#   ├── f5-tts/
#   │   └── model.safetensors          (~2GB)
#   ├── whisper/
#   │   └── model.bin                  (~1.5GB)
#   └── musicgen/
#       └── pytorch_model.bin          (~9GB)
#
AUDIO_WORKER_ID=audio-01
F5_TTS_MODEL_PATH=/models/f5-tts
WHISPER_MODEL_PATH=/models/whisper
MUSICGEN_MODEL_PATH=/models/musicgen
WHISPER_MODEL_SIZE=medium
SAMPLE_RATE=44100
AUDIO_FORMAT=wav
VOICE_CLONE_ENABLED=true

# --- Editor Worker (FFmpeg) ---
# 部署至: CPU (可選 GPU 加速)
EDITOR_WORKER_ID=editor-01
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
OUTPUT_FORMAT=mp4
OUTPUT_WIDTH=1920
OUTPUT_HEIGHT=1080
OUTPUT_FPS=24
OUTPUT_VIDEO_BITRATE=10M
OUTPUT_AUDIO_BITRATE=192k

# ========================================
# LLM Worker 設定
# ========================================
# LLM Worker 負責文字生成任務：角色分析、故事生成、腳本生成、場景 JSON
# 部署至: CPU (API 呼叫，不需要 GPU)
#
# --- LLM Provider 選擇 (二選一) ---
#
# 方案 A: Google Gemini API (測試階段推薦)
#   1. 取得 API Key: https://aistudio.google.com/apikey
#   2. 將下方 LLM_PROVIDER 設為 "gemini"
#   3. 填入你的 Gemini API Key
#
# 方案 B: 本地 LLM API (如 Ollama, vLLM, LM Studio)
#   1. 部署本地 LLM 服務
#   2. 將下方 LLM_PROVIDER 設為 "local"
#   3. 設定 LLM_API_URL 為本地 API 位址 (例如: http://host.docker.internal:11434/v1)
#   4. 如有 API Key 也一併填入
#
# --- Gemini API 模型選擇 ---
#   gemini-2.5-flash      (快速，推薦)
#   gemini-2.0-flash      (快速，生產環境)
#   gemini-2.0-pro-exp    (高品質，較慢)
#
# --- 本地 LLM 模型推薦 ---
#   llama-3.1-8b-instruct (8GB VRAM, 基本功能)
#   llama-3.1-70b-instruct (需要多 GPU, 高品質)
#   mistral-7b-instruct   (輕量，快速)
#
LLM_WORKER_ID=llm-01

# LLM Provider: "gemini" 或 "local"
LLM_PROVIDER=local

# Gemini API 設定 (當 LLM_PROVIDER=gemini 時使用)
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-2.5-flash

# 本地 LLM API 設定 (當 LLM_PROVIDER=local 時使用)
LLM_API_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3.1

# LLM 生成參數 (本地模型建議增加 max_tokens)
LLM_MAX_TOKENS=16384
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9

# ========================================
# 獨立部署模式 (可選)
# ========================================
# 如果 Worker 部署到不同的機器，修改以下設定:

# Image Worker (獨立部署時)
# IMAGE_WORKER_API_BASE_URL=http://<api-server-ip>:8000
# IMAGE_WORKER_S3_ENDPOINT=http://<minio-server-ip>:9000

# Video Worker (獨立部署時)
# VIDEO_WORKER_API_BASE_URL=http://<api-server-ip>:8000
# VIDEO_WORKER_S3_ENDPOINT=http://<minio-server-ip>:9000

# Audio Worker (獨立部署時)
# AUDIO_WORKER_API_BASE_URL=http://<api-server-ip>:8000
# AUDIO_WORKER_S3_ENDPOINT=http://<minio-server-ip>:9000

# Editor Worker (獨立部署時)
# EDITOR_WORKER_API_BASE_URL=http://<api-server-ip>:8000
# EDITOR_WORKER_S3_ENDPOINT=http://<minio-server-ip>:9000
